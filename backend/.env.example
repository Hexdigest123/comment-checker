HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://comment_checker:your_secure_db_password_here@db:5432/comment_checker
DB_HOST=db
DB_PORT=5432
DB_NAME=comment_checker
DB_USER=comment_checker
DB_PASSWORD=your_secure_db_password_here
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=your_secure_admin_password_here
MISTRAL_API_KEY=

# Generate embeddings for uploaded comments (Mistral mistral-embed API, billed per token)
# Set to false to skip embeddings on upload and save API costs
GENERATE_EMBEDDINGS=true
CLASSIFICATION_THRESHOLD=0.3
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
LOG_LEVEL=INFO

# ExportComments.com integration for direct URL import (optional)
EXPORTCOMMENTS_API_KEY=

# Classification worker (job queue that processes PENDING comments)
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_BATCH_SIZE=10
