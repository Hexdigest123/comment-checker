---
import RootLayout from '../layouts/RootLayout.astro';
import { useState, useEffect, useCallback } from 'react';
import { DataTable, BackendBadge, CategoryBadge, SeverityBadge, Button } from '../components';
import { useAuth } from '../services/auth';
import { classificationApi } from '../services/api';
import type { Classification, PageResponse } from '../types';

const ClassificationsPage = () => {
  const { isAuthenticated, isLoading: authLoading } = useAuth();
  const [classifications, setClassifications] = useState<Classification[]>([]);
  const [total, setTotal] = useState(0);
  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] = useState(10);
  const [search, setSearch] = useState('');
  const [backendFilter, setBackendFilter] = useState('');
  const [categoryFilter, setCategoryFilter] = useState('');
  const [sortBy, setSortBy] = useState('created_at');
  const [sortOrder, setSortOrder] = useState<'asc' | 'desc'>('desc');
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState('');

  const fetchClassifications = useCallback(async () => {
    if (!isAuthenticated) return;

    setIsLoading(true);
    setError('');

    try {
      const params: Record<string, string | number> = {
        page,
        page_size: pageSize,
        sort_by: sortBy,
        sort_order: sortOrder,
      };

      if (search) params.search = search;
      if (backendFilter) params.backend = backendFilter;
      if (categoryFilter) params.category = categoryFilter;

      const response = await classificationApi.list(params as unknown as { page?: number; page_size?: number; comment_id?: string; backend?: string; category?: string });
      const data = response.data as PageResponse<Classification>;
      setClassifications(data.items);
      setTotal(data.total);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to fetch classifications');
    } finally {
      setIsLoading(false);
    }
  }, [isAuthenticated, page, pageSize, search, backendFilter, categoryFilter, sortBy, sortOrder]);

  useEffect(() => {
    fetchClassifications();
  }, [fetchClassifications]);

  const columns = [
    { key: 'comment_id', header: 'Comment ID', sortable: true },
    { key: 'backend', header: 'Backend', sortable: true, render: (item: Classification) => <BackendBadge backend={item.backend} /> },
    { key: 'category', header: 'Category', sortable: true, render: (item: Classification) => <CategoryBadge category={item.category} /> },
    { key: 'severity', header: 'Severity', sortable: true, render: (item: Classification) => <SeverityBadge severity={item.severity} /> },
    { key: 'confidence', header: 'Confidence', sortable: true, render: (item: Classification) => `${(item.confidence * 100).toFixed(1)}%` },
    { key: 'harmful_score', header: 'Harmful Score', sortable: true, render: (item: Classification) => item.harmful_score.toFixed(2) },
    { key: 'created_at', header: 'Classified At', sortable: true },
  ];

  if (authLoading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <div className="animate-spin h-12 w-12 border-4 border-blue-500 border-t-transparent rounded-full"></div>
      </div>
    );
  }

  if (!isAuthenticated) {
    return (
      <div className="p-8">
        <div className="bg-yellow-50 text-yellow-600 p-4 rounded-lg">
          Please login to view classifications
        </div>
      </div>
    );
  }

  return (
    <div className="p-8">
      <div className="flex justify-between items-center mb-6">
        <h1 className="text-3xl font-bold text-gray-800">Classifications</h1>
      </div>

      {error && (
        <div className="bg-red-50 text-red-600 p-4 rounded-lg mb-6">
          {error}
        </div>
      )}

      <DataTable
        data={classifications}
        columns={columns}
        total={total}
        page={page}
        pageSize={pageSize}
        onPageChange={setPage}
        onPageSizeChange={setPageSize}
        onSortChange={(by, order) => {
          setSortBy(by);
          setSortOrder(order);
        }}
        onSearchChange={(s) => {
          setSearch(s);
          setPage(1);
        }}
        onFilterChange={(filters) => {
          setBackendFilter(filters.backend || '');
          setCategoryFilter(filters.category || '');
          setPage(1);
        }}
        currentSortBy={sortBy}
        currentSortOrder={sortOrder}
        currentSearch={search}
        currentFilters={{ backend: backendFilter, category: categoryFilter }}
        searchPlaceholder="Search classifications..."
        showSearch={true}
        showPagination={true}
        showFilters={true}
        filterOptions={[
          {
            key: 'backend',
            label: 'Backend',
            options: [
              { value: 'typesafe', label: 'TypeSafe' },
              { value: 'mistral', label: 'Mistral' },
              { value: 'combined', label: 'Combined' },
            ],
          },
          {
            key: 'category',
            label: 'Category',
            options: [
              { value: 'hate', label: 'Hate' },
              { value: 'harassment', label: 'Harassment' },
              { value: 'violence', label: 'Violence' },
              { value: 'self_harm', label: 'Self Harm' },
              { value: 'sexual', label: 'Sexual' },
              { value: 'spam', label: 'Spam' },
              { value: 'illegal', label: 'Illegal' },
              { value: 'safe', label: 'Safe' },
            ],
          },
        ]}
        isLoading={isLoading}
        emptyMessage="No classifications found"
      />
    </div>
  );
};
---

<RootLayout title="Classifications - Comment Checker">
  <ClassificationsPage client:load />
</RootLayout>
