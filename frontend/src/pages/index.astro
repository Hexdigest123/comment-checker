---
// Dashboard page
import RootLayout from '../layouts/RootLayout.astro';
import DashboardClient from '../components/DashboardClient';
---

<RootLayout title="Dashboard - Comment Checker">
  <div class="space-y-8 animate-fade-in">
    <!-- Page header -->
    <div class="flex justify-between items-center">
      <div>
        <span class="eyebrow-badge">Overview</span>
        <h1 class="mt-3 font-display text-4xl font-semibold text-mistral-ink leading-tight">Dashboard</h1>
        <p class="text-mistral-muted mt-2">Overview of your comment classification system</p>
      </div>
    </div>
    
    <!-- Dashboard content -->
    <DashboardClient client:load />
  </div>
</RootLayout>
