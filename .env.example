# =============================================================================
# COMMENT CHECKER - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in the values
# For production, set these in GitHub Secrets or your deployment environment
#
# This is the primary configuration file. Service-specific overrides can be
# placed in backend/.env and frontend/.env

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# API KEYS (Required for classification)
# -----------------------------------------------------------------------------
# At least one of these is required depending on your backend choice

# Mistral API Key - Required for mistral backend
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=

# TypeSafe API Key - Required for typesafe backend
# Get from: https://typesafe.ai/
TYPESAFE_API_KEY=

# ExportComments API Key - Required for direct URL export
# Get from: https://app.exportcomments.com/api
# Requires Premium or Business plan
EXPORTCOMMENTS_API_KEY=

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND SERVICE
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# FRONTEND SERVICE
# -----------------------------------------------------------------------------
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# Required for backend service

DB_HOST=db
DB_PORT=5432
DB_NAME=comment_checker
DB_USER=comment_checker
DB_PASSWORD=your_secure_db_password_here

# Full connection URL (alternative to individual settings)
# DATABASE_URL=postgresql+asyncpg://comment_checker:your_secure_db_password_here@db:5432/comment_checker

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# Required for backend service

# JWT Secret Key - Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# Access Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token expiry (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Algorithm for JWT
ALGORITHM=HS256

# Password hashing - bcrypt cost factor (12-14 recommended)
BCRYPT_COST_FACTOR=12

# First Admin (auto-created on first startup if no admin exists)
FIRST_ADMIN_EMAIL=admin@localhost
FIRST_ADMIN_PASSWORD=your_secure_admin_password_here

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Required for password reset and admin invites

# SMTP Settings
# For development, use Mailpit (included in docker-compose)
# For production, use real SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=False

# Email sender
EMAIL_FROM=noreply@comment-checker.local
EMAIL_FROM_NAME=Comment Checker

# =============================================================================
# CLASSIFICATION CONFIGURATION
# =============================================================================

# Default backend for classification: mistral
DEFAULT_BACKEND=mistral

# Threshold for flagging (0.0-1.0)
CLASSIFICATION_THRESHOLD=0.3

# Maximum comments to process at once
MAX_COMMENTS_PER_REQUEST=100

# =============================================================================
# CSV PROCESSING CONFIGURATION
# =============================================================================

# Maximum CSV file size (MB)
MAX_CSV_SIZE_MB=50

# CSV delimiter (usually comma or semicolon)
CSV_DELIMITER=,

# =============================================================================
# DASHBOARD CONFIGURATION
# =============================================================================

# Default date range for dashboard (1m, 6m, 1y, all)
DASHBOARD_DEFAULT_RANGE=1y

# Pagination options
PAGINATION_OPTIONS=5,10,15,25
DEFAULT_PAGINATION=10

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# =============================================================================
# PRODUCTION FLAG
# =============================================================================
# Set to "true" in production
PRODUCTION=false

# =============================================================================
# EXPORTCOMMENTS CONFIGURATION (Optional)
# =============================================================================
# Settings for direct social media URL export

# Maximum time to wait for export completion (seconds)
EXPORTCOMMENTS_TIMEOUT=300

# Polling interval for job status (seconds)
EXPORTCOMMENTS_POLL_INTERVAL=2.0

# Include reply threads by default
EXPORTCOMMENTS_INCLUDE_REPLIES=false

# =============================================================================
# NOTES
# =============================================================================
# 1. For development, use: make setup
# 2. For production, use docker-compose.prod.yml
# 3. All sensitive values should be set in production via secrets management
# 4. The backend requires at least one API key (MISTRAL_API_KEY or TYPESAFE_API_KEY)
# 5. EXPORTCOMMENTS_API_KEY requires a Premium or Business plan
