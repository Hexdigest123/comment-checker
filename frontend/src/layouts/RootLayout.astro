---
// Root layout for all pages
import '../styles/global.css';
import NavBar from '../components/NavBar';

interface Props {
  title?: string;
  /** Chat-like pages: full-height column, no container width, padding, or footer. */
  fullBleed?: boolean;
}

const { title = 'Comment Checker', fullBleed = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Comment Checker - Classify comments for hate speech and harmful content" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline>
    // Apply the theme before first paint to avoid a flash.
    (function () {
      var stored = localStorage.getItem('theme');
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body class="font-sans antialiased bg-mistral-surface text-mistral-ink transition-colors duration-300">
  <div class="min-h-screen flex flex-col">
    <!-- Navigation (client component: shows user state + logout) -->
    <NavBar client:only="react" />

    <!-- Main content -->
    {fullBleed ? (
      <main class="flex-1 flex flex-col min-h-0 w-full">
        <slot />
      </main>
    ) : (
      <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
        <slot />
      </main>
    )}

    {fullBleed ? null : (
      <footer class="border-t border-mistral-border py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center font-mono text-xs uppercase tracking-widest text-mistral-muted">
            &copy; {new Date().getFullYear()} Comment Checker
          </div>
        </div>
      </footer>
    )}
  </div>
</body>
</html>
