# =============================================================================
# COMMENT CHECKER MONOREPO - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in the values
# For production, set these in GitHub Secrets or your deployment environment

# -----------------------------------------------------------------------------
# BACKEND CONFIGURATION
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# -----------------------------------------------------------------------------
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=comment_checker
DB_USER=comment_checker
DB_PASSWORD=your_secure_db_password_here

# -----------------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------------------
# JWT Secret Key - Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production

# Access Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token expiry (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Algorithm for JWT
ALGORITHM=HS256

# Password hashing - bcrypt cost factor (12-14 recommended)
BCRYPT_COST_FACTOR=12

# First Admin (auto-created on first startup if no admin exists)
FIRST_ADMIN_EMAIL=admin@localhost
FIRST_ADMIN_PASSWORD=your_secure_admin_password_here

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (for password reset and admin invites)
# -----------------------------------------------------------------------------
# For development, use Mailpit (included in docker-compose)
# For production, use real SMTP

# SMTP Settings
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=False

# Email sender
EMAIL_FROM=noreply@comment-checker.local
EMAIL_FROM_NAME=Comment Checker

# -----------------------------------------------------------------------------
# EXTERNAL API KEYS
# -----------------------------------------------------------------------------
# TypeSafe API Key for Jev model
TYPESAFE_API_KEY=

# Mistral API Key for Moderation 2 and fallback
MISTRAL_API_KEY=

# ExportComments API Key for direct social media comment export
EXPORTCOMMENTS_API_KEY=

# -----------------------------------------------------------------------------
# CLASSIFICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Default backend for classification: typesafe, mistral, or combined
DEFAULT_BACKEND=mistral

# Threshold for flagging (0.0-1.0)
CLASSIFICATION_THRESHOLD=0.3

# Maximum comments to process at once
MAX_COMMENTS_PER_REQUEST=100

# -----------------------------------------------------------------------------
# CSV PROCESSING CONFIGURATION
# -----------------------------------------------------------------------------
# Maximum CSV file size (MB)
MAX_CSV_SIZE_MB=50

# CSV delimiter (usually comma or semicolon)
CSV_DELIMITER=,

# -----------------------------------------------------------------------------
# DASHBOARD CONFIGURATION
# -----------------------------------------------------------------------------
# Default date range for dashboard (1m, 6m, 1y, all)
DASHBOARD_DEFAULT_RANGE=1y

# Pagination options
PAGINATION_OPTIONS=5,10,15,25
DEFAULT_PAGINATION=10

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# -----------------------------------------------------------------------------
# PRODUCTION FLAG
# -----------------------------------------------------------------------------
# Set to "true" in production
PRODUCTION=false
